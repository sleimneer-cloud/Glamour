   <string notr="true">/* 창 전체와 중앙 위젯의 배경을 모두 하얀색으로 덮습니다 */
QMainWindow, QWidget#centralwidget {
    background-color: #FFFFFF;
}</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* 1. 메인 배경: 쨍한 흰색이 아닌, 로그인 창 느낌의 눈 편안한 연회색 */
QMainWindow, QWidget#centralwidget {
    background-color: #F0F0F0; 
}

/* 2. 텍스트 라벨: 짙은 회색에서 Glamour 퍼플 색상으로 변경 */
QLabel {
    color: #8B5CF6; /* 요청하신 보라색 적용 */
    font-weight: bold;
    font-size: 13px;
}

/* 3. 입력창 &amp; 박스: 둥근 모서리와 얇은 연보라색 테두리 (핵심!) */
QLineEdit, QTextEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C4B5E3; /* 로그인 창 'ID', 'PW' 테두리와 같은 연보라색 */
    border-radius: 12px;       /* 모서리를 많이 둥글게 처리 */
    padding: 10px;
    color: #8C72CB;            /* 입력되는 글씨도 은은한 보라색 톤으로 */
    font-size: 14px;
    font-weight: bold;
}

/* 입력창 포커스: 클릭했을 때 테두리만 살짝 더 진해짐 */
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 2px solid #9D7CD8;
}

/* 4. 메인 버튼: 그라데이션 없는 플랫한 파스텔 보라색 단색 + 완전 둥근 모서리 */
QPushButton {
    background-color: #A388E3; /* 로그인 창 버튼과 동일한 파스텔 톤 */
    color: #FFFFFF;
    border: none;              /* 테두리 없음 */
    border-radius: 20px;       /* 알약처럼 양끝이 완전히 둥글게 */
    padding: 12px 20px;
    font-size: 15px;
    font-weight: bold;
}

/* 버튼 마우스 호버 시: 살짝 뽀얗게 밝아짐 */
QPushButton:hover {
    background-color: #B29BF0; 
}

/* 버튼 눌렀을 때: 살짝 차분해짐 */
QPushButton:pressed {
    background-color: #8C64C8; 
}

/* 5. 콤보박스 화살표 디자인 정리 */
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}</string>

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import requests
import pymysql

app = FastAPI(
    title="Glamour Main Server",
    description="클라이언트 요청을 받아 AI 서버로 넘기고, 결과를 DB에 저장하는 메인 서버"
)

DB_CONFIG = {
    'host': '127.0.0.1',
    'user': 'glamour_admin', 
    'password': '1234',       
    'database': 'glamour',
    'charset': 'utf8mb4'
}
AI_SERVER_URL = "http://127.0.0.1:8001/feedback"

class ClientRequest(BaseModel):
    user_id: int = 1 
    text: str
    situation: str = "일반 비즈니스"
    intent: str
    error_limit: int = 10

@app.post("/process-text")
def process_client_text(request: ClientRequest):
    # 💡 1. DB에서 이 유저가 과거에 자주 틀린 오답 노트(Top 3) 꺼내오기!
    past_errors_text = ""
    try:
        conn = pymysql.connect(**DB_CONFIG)
        cursor = conn.cursor()

        # 조인(JOIN)을 활용해 특정 유저의 카테고리별 에러 횟수 조회
        fetch_sql = """
            SELECT error_category, COUNT(*) as cnt
    FROM (
        SELECT error_category
        FROM error_details
        WHERE log_id IN (
            SELECT log_id 
            FROM grammar_logs 
            WHERE user_id = %s
        )
        ORDER BY created_at DESC  -- error_details의 시간을 기준
        LIMIT %s
    ) AS recent_errors
    GROUP BY error_category
    ORDER BY cnt DESC
    LIMIT 3 
        """
        cursor.execute(fetch_sql, (request.user_id, request.error_limit))
        rows = cursor.fetchall()

        if rows:
            # ex) "'시제 오류' (3회), '부적절한 어휘' (2회)" 형태로 문자열 만들기
            error_list = [f"'{row[0]}' (총 {row[1]}회)" for row in rows]
            past_errors_text = ", ".join(error_list)
        else:
            past_errors_text = "아직 기록이 없는 새로운 학생입니다."

    except Exception as e:
        print(f"DB 조회 에러: {e}")
        past_errors_text = "과거 기록 조회 실패"
    
    # 💡 2. AI 서버로 데이터 토스 (조회한 과거 취약점 데이터 past_errors 를 같이 넘깁니다!)
    try:
        ai_response = requests.post(#.post()는 HTTP POST 요청을 보내는 함수입니다.
            AI_SERVER_URL,
            json={
                "text": request.text, 
                "situation": request.situation,
                "past_errors": past_errors_text, # <-- 핵심!
                "intent": request.intent
            }
        )
        ai_data = ai_response.json() #.json()는 HTTP 응답의 본문을 JSON 형식으로 파싱하여 Python 딕셔너리로 반환하는 메서드입니다.
    except Exception as e:
        if 'conn' in locals() and conn.open: conn.close()
        return {"status": "error", "message": f"AI 서버 통신 실패: {str(e)}"}

    if ai_data.get("status") != "success": 
        if 'conn' in locals() and conn.open: conn.close()
        return {"status": "error", "message": ai_data.get("message", "AI 분석 실패")}

    result = ai_data["data"]

     # AI 서버가 보낸 JSON에서 'feedback' 바구니를 꺼내오는 로직입니다.
    feedback = result.get("feedback", {}) 

    # 💡 3. 돌려받은 결과를 MariaDB에 저장 (기존과 동일)
    try:
        #1. 그래머 로그 테이블 저장
        log_sql = "INSERT INTO grammar_logs (user_id, original_text, corrected_text) VALUES (%s, %s, %s)"
        cursor.execute(log_sql, (request.user_id, result["original"], result["corrected"]))
        inserted_log_id = cursor.lastrowid 

        #2. 에러 디테일 테이블 저장 
        safe_category = result.get("error_category", "")[:255]
        
        err_sql = """
            INSERT INTO error_details (log_id, error_category, strengths, improvements, cheer_up) 
            VALUES (%s, %s, %s, %s, %s)
        """
        # feedback 딕셔너리에서 안전하게 데이터를 꺼내옵니다.
        cursor.execute(err_sql, (
            inserted_log_id, 
            safe_category, 
            feedback.get("strengths", ""),     # 잘한 점
            feedback.get("improvements", ""),  # 보완할 점
            feedback.get("cheer_up", "")       # 응원 문구
        ))

        conn.commit() 
    except Exception as e:
        return {"status": "error", "message": f"DB 저장 실패: {str(e)}"}
    finally:
        if 'conn' in locals() and conn.open:
            conn.close()

    return {
        "status": "success",
        "message": "맞춤형 AI 분석 및 DB 저장 완료!",
        "data": result,
        "past_errors_used": past_errors_text, # 클라이언트도 볼 수 있게 리턴
        "log_id": inserted_log_id  # 🌟 추가: 방금 DB에 저장된 로그의 ID를 클라이언트로 돌려줍니다!
    }
# 🌟 추가: 클라이언트가 보내줄 오답 횟수 데이터 형식 정의
class RetryRequest(BaseModel):
    log_id: int
    retry_count: int

# 🌟 추가: 오답 횟수만 업데이트하는 새로운 창구
@app.post("/update-retries")
def update_retries(request: RetryRequest):
    try:
        conn = pymysql.connect(**DB_CONFIG)
        cursor = conn.cursor()
        
        update_sql = "UPDATE grammar_logs SET assembly_retries = %s WHERE log_id = %s"
        cursor.execute(update_sql, (request.retry_count, request.log_id))
        conn.commit()
        
        return {"status": "success", "message": "오답 횟수 업데이트 완료!"}
    except Exception as e:
        if 'conn' in locals(): conn.rollback()
        return {"status": "error", "message": str(e)}
    finally:
        if 'conn' in locals() and conn.open:
            conn.close()